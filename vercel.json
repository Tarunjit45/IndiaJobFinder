{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api|_next|static|sitemap\\.xml|robots\\.txt|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}